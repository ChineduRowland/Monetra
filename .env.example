# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# CLERK AUTHENTICATION (Optional for Preview Mode; required for production Clerk auth)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Required if deploying serverless Preview Auth without Clerk so tokens stay valid across cold starts
SESSION_SECRET=

# SUPABASE POSTGRESQL (Optional for Preview Mode; required for production Supabase DB)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OPEN BANKING (Optional future Mono integration; MVP uses read-only sandbox simulation)
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
